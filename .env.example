# Copiar a .env (junto al docker-compose.yml) y descomentar lo que se quiera cambiar.
# Los valores mostrados son los defaults.

# Puerto publicado de la API. Para exponerla solo en loopback: 127.0.0.1:8080
#EXTRACTOR_PUERTO=8080

#EXTRACTOR_OLLAMA_MODELO=qwen3-vl:4b
#EXTRACTOR_OLLAMA_THINK=false
# En CPU subir (p. ej. 600s) y, con concurrencia > 1, subir también ESPERAMAXIMA.
#EXTRACTOR_OLLAMA_TIMEOUT=90s
#EXTRACTOR_OLLAMA_NUMCTX=8192
# Tope de tokens que escribe el modelo; si se alcanza la API responde 422.
#EXTRACTOR_OLLAMA_NUMPREDICT=2048

# Para medir concurrencia N subir las dos juntas.
#EXTRACTOR_CONCURRENCIA_MAXLLM=1
#OLLAMA_NUM_PARALLEL=1
#EXTRACTOR_CONCURRENCIA_ESPERAMAXIMA=60s

#EXTRACTOR_DOCUMENTO_MAXPAGINAS=10
#EXTRACTOR_DOCUMENTO_DPIIMAGEN=150
#EXTRACTOR_DOCUMENTO_DPIQR=200
#EXTRACTOR_DOCUMENTO_MAXLADOPX=2000
#EXTRACTOR_DOCUMENTO_UMBRALCARACTERESPORPAGINA=50

# Contiene datos de las facturas en los logs: solo para diagnóstico.
#EXTRACTOR_DEBUG_LOGPROMPTS=false

# Tamaños multipart. El umbral debe ser >= max-request-size para que nada se escriba a disco.
#SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
#SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=11MB
#SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=11MB
