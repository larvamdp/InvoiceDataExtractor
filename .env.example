# Copiar a .env (junto al docker-compose.yml) y descomentar lo que se quiera cambiar.
# Los valores mostrados son los defaults.

# Proveedor de IA: OLLAMA (default) | AZURE_OPENAI | VERTEX_GEMINI.
# El contenedor ollama solo se levanta con el perfil "ollama": dejarlo activo solo con OLLAMA.
COMPOSE_PROFILES=ollama
#EXTRACTOR_LLM_PROVEEDOR=OLLAMA

# --- Azure OpenAI (EXTRACTOR_LLM_PROVEEDOR=AZURE_OPENAI; comentar COMPOSE_PROFILES) ---
# Obligatorias: ENDPOINT, DEPLOYMENT y APIKEY. Si falta alguna el servicio no arranca y el log la nombra.
#EXTRACTOR_AZURE_ENDPOINT=https://mi-recurso.openai.azure.com
#EXTRACTOR_AZURE_DEPLOYMENT=mi-deployment
#EXTRACTOR_AZURE_APIKEY=
#EXTRACTOR_AZURE_APIVERSION=2024-10-21
#EXTRACTOR_AZURE_TIMEOUT=90s
#EXTRACTOR_AZURE_MAXTOKENS=4096
# Modelos de razonamiento: no envía temperature, envía reasoning_effort "low". Requiere
# APIVERSION 2024-12-01-preview o posterior y subir MAXTOKENS (el razonamiento cuenta como tokens).
#EXTRACTOR_AZURE_RAZONAMIENTO=false

# --- Vertex AI / Gemini (EXTRACTOR_LLM_PROVEEDOR=VERTEX_GEMINI; comentar COMPOSE_PROFILES) ---
# Obligatorias: PROYECTO, REGION, MODELO y CREDENCIALES (JSON de la cuenta de servicio, en ./secretos).
#EXTRACTOR_VERTEX_PROYECTO=mi-proyecto
# Región (p. ej. us-central1) o "global" (Google puede procesar los datos en cualquier región).
#EXTRACTOR_VERTEX_REGION=us-central1
#EXTRACTOR_VERTEX_MODELO=gemini-2.5-flash
#EXTRACTOR_VERTEX_CREDENCIALES=/run/secretos/vertex.json
#EXTRACTOR_VERTEX_TIMEOUT=90s
#EXTRACTOR_VERTEX_MAXTOKENS=4096
# thinkingBudget de Gemini (0 desactiva el razonamiento en 2.5 Flash; algunos modelos exigen un mínimo).
# Sin definir no se envía.
#EXTRACTOR_VERTEX_PRESUPUESTORAZONAMIENTO=0

# --- Proxy saliente (solo Azure/Vertex y el token de Google; Ollama no lo usa) ---
#EXTRACTOR_PROXY_HOST=proxy.empresa.local
#EXTRACTOR_PROXY_PUERTO=3128
#EXTRACTOR_PROXY_USUARIO=
#EXTRACTOR_PROXY_CLAVE=
# CA corporativa (PEM) si el proxy inspecciona TLS; se suma a las CA del JDK.
#EXTRACTOR_PROXY_CAEXTRA=/run/secretos/ca-proxy.pem

# Puerto publicado de la API. Para exponerla solo en loopback: 127.0.0.1:8080
#EXTRACTOR_PUERTO=8080

# Usar variantes "instruct": el tag qwen3-vl:4b es la variante "thinking", que razona siempre
# (ignora think=false) y agota el tope de tokens antes de responder.
#EXTRACTOR_OLLAMA_MODELO=qwen3-vl:4b-instruct
#EXTRACTOR_OLLAMA_THINK=false
# En CPU subir (p. ej. 600s) y, con concurrencia > 1, subir también ESPERAMAXIMA.
#EXTRACTOR_OLLAMA_TIMEOUT=90s
#EXTRACTOR_OLLAMA_NUMCTX=8192
# Tope de tokens que escribe el modelo; si se alcanza la API responde 422.
#EXTRACTOR_OLLAMA_NUMPREDICT=2048

# Sin definir: 1 con Ollama y 4 con proveedores en la nube.
# Para medir concurrencia N con Ollama subir las dos juntas.
#EXTRACTOR_CONCURRENCIA_MAXLLM=1
#OLLAMA_NUM_PARALLEL=1
#EXTRACTOR_CONCURRENCIA_ESPERAMAXIMA=60s

#EXTRACTOR_DOCUMENTO_MAXPAGINAS=10
#EXTRACTOR_DOCUMENTO_DPIIMAGEN=150
#EXTRACTOR_DOCUMENTO_DPIQR=200
#EXTRACTOR_DOCUMENTO_MAXLADOPX=2000
#EXTRACTOR_DOCUMENTO_UMBRALCARACTERESPORPAGINA=50

# Contiene datos de las facturas en los logs: solo para diagnóstico.
#EXTRACTOR_DEBUG_LOGPROMPTS=false

# Tamaños multipart. El umbral debe ser >= max-request-size para que nada se escriba a disco.
#SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
#SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=11MB
#SPRING_SERVLET_MULTIPART_FILE_SIZE_THRESHOLD=11MB
